# Copia este archivo como .env (local) o configura estas variables en tu hosting (producción).

# URL de la API (backend). En producción, ej.: https://api.certificahub.mx/api
VITE_API_URL=http://localhost:5168/api

# Token de Cloudflare Web Analytics (opcional). Se obtiene en Cloudflare > Analytics & Logs >
# Web Analytics al agregar el sitio. Si se deja vacío, la analítica no se carga.
VITE_CF_ANALYTICS_TOKEN=
